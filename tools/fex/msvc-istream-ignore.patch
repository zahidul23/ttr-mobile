+// TTR Mobile: emitted at the head of MSVC's std::istream::ignore(count, delim) loop, which otherwise takes one
+// character per iteration through three calls (sbumpc, _Gnavail, the gcount increment). When the delimiter is
+// EOF, so no character can match it, every character still in the stream buffer's get area is consumed the same
+// way; this does those iterations at once: the get pointer, the buffer's count, gcount and the remaining count
+// move by min(buffered, remaining). The loop's own code then runs as before for the next character, which
+// refills the buffer or ends the loop. Branch-free: with nothing to skip, N is 0 and the stores rewrite what
+// was there.
+//
+// Loop registers (fixed by the byte pattern that selects this): RBX remaining count, RDI the istream, EBP delim.
+void OpDispatchBuilder::EmitMSVCIstreamIgnoreFastPath() {
+  const auto S64 = OpSize::i64Bit;
+  const auto S32 = OpSize::i32Bit;
+  Ref Count = LoadGPRRegister(X86State::REG_RBX);
+  Ref This = LoadGPRRegister(X86State::REG_RDI);
+  Ref Delim = LoadGPRRegister(X86State::REG_RBP);
+  Ref Zero = Constant(0);
+
+  // rdbuf(): the ios base is at this + vbtable[1]; its stream buffer pointer at +0x48.
+  Ref VBTable = _LoadMemGPRAutoTSO(S64, This);
+  Ref IosOffset = _Sbfe(S64, 32, 0, _LoadMemGPRAutoTSO(S32, _Add(S64, VBTable, Constant(4))));
+  Ref Buffer = _LoadMemGPRAutoTSO(S64, _Add(S64, _Add(S64, This, IosOffset), Constant(0x48)));
+  // streambuf: _IGnext (+0x38) points at the get pointer, _IGcount (+0x50) at the int count of characters left.
+  Ref NextPtr = _LoadMemGPRAutoTSO(S64, _Add(S64, Buffer, Constant(0x38)));
+  Ref CountPtr = _LoadMemGPRAutoTSO(S64, _Add(S64, Buffer, Constant(0x50)));
+  Ref Next = _LoadMemGPRAutoTSO(S64, NextPtr);
+  Ref Avail = _Sbfe(S64, 32, 0, _LoadMemGPRAutoTSO(S32, CountPtr));
+
+  Ref N = _Select(S64, S64, CondClass::SLT, Avail, Count, Avail, Count);
+  N = _Select(S64, S64, CondClass::SGT, N, Zero, N, Zero);
+  N = _Select(S64, S64, CondClass::EQ, Next, Zero, Zero, N);                               // no get area
+  N = _Select(S64, S64, CondClass::EQ, Count, Constant(0x7fff'ffff'ffff'ffffLL), Zero, N); // "unlimited" count
+  N = _Select(S64, S32, CondClass::EQ, Delim, Constant(0xffff'ffffLL), N, Zero);           // only delim == EOF
+
+  _StoreMemGPRAutoTSO(S64, NextPtr, _Add(S64, Next, N));
+  _StoreMemGPRAutoTSO(S32, CountPtr, _Sub(S64, Avail, N));
+  Ref GCountAddr = _Add(S64, This, Constant(8));
+  _StoreMemGPRAutoTSO(S64, GCountAddr, _Add(S64, _LoadMemGPRAutoTSO(S64, GCountAddr), N));
+  StoreGPRRegister(X86State::REG_RBX, _Sub(S64, Count, N));
+}
